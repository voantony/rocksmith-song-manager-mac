<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MacSongManager.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <SolidColorBrush x:Key="MsmInk" Color="#142028"/>
    <SolidColorBrush x:Key="MsmMuted" Color="#5C6B73"/>
    <SolidColorBrush x:Key="MsmPaper" Color="#F3F6F6"/>
    <SolidColorBrush x:Key="MsmAccent" Color="#0E6B62"/>
    <SolidColorBrush x:Key="MsmSidebar" Color="#10242A"/>
    <SolidColorBrush x:Key="MsmLine" Color="#D5DEE0"/>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0,4"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource MsmAccent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Application.Styles>
</Application>
