<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.3.0</Version>
    <Company>Antony Vo</Company>
    <Product>Mac Song Manager</Product>
    <Copyright>Copyright © 2026 Antony Vo. Conversion support adapted from glebb/rocksmithconvert (GPL-3.0-or-later) and pyrocksmith by 0x0L (MIT).</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
</Project>
